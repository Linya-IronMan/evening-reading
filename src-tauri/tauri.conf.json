{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "evening-reading",
  "version": "0.2.2",
  "identifier": "com.linya.eveningreading",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Evening Reading - 晚读",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Linya-IronMan/evening-reading/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEN0E3NUFCMUE1NDVGNzIKUldSeVgxUWFxM1Y2L1Ird0JSbGh4aVhTY3RGSGNxQlZHS3FZTjJ3MW8yem1UOHlBZ1JDVitGL0cK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
